# Copy to backend/.env (or export) – all optional.
# FISZKI_ADDR=0.0.0.0:8080
# FISZKI_DB=../data/fiszki.db
# FISZKI_STATIC=../frontend/dist
# GEMINI_API_KEY=AIza...          # or paste it in the app's Settings screen
# RUST_LOG=info

# Safeguards (see README → Safeguards)
# FISZKI_BASIC_AUTH=me:a-long-password   # HTTP Basic auth for the whole app (off when unset); use over HTTPS/VPN only
# FISZKI_EXTRACT_DAILY_CAP=60            # max photo extractions per local day, 0 = unlimited
# FISZKI_EXTRACT_PER_MINUTE=6            # max photo extractions per minute, 0 = unlimited
