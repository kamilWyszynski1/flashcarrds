# Copy to backend/.env (or export) – all optional except GEMINI_API_KEY for photo extraction.
# FISZKI_ADDR=0.0.0.0:8080
# FISZKI_DB=../data/fiszki.db
# FISZKI_STATIC=../frontend/dist
# RUST_LOG=info                         # add fiszki_server=debug to log every Gemini call

# Gemini – server-side only; not stored in the DB and not settable from the app.
# GEMINI_API_KEY=AIza...                # https://aistudio.google.com/apikey
# FISZKI_GEMINI_MODEL=gemini-flash-latest   # e.g. gemini-2.5-flash-lite when the default alias is overloaded
# FISZKI_GEMINI_TIMEOUT_SECS=30         # per-attempt upstream timeout (5–300)

# Safeguards (see README → Safeguards)
# FISZKI_BASIC_AUTH=me:a-long-password   # HTTP Basic auth for the whole app (off when unset); use over HTTPS/VPN only
# FISZKI_EXTRACT_DAILY_CAP=60            # max photo extractions per local day, 0 = unlimited
# FISZKI_EXTRACT_PER_MINUTE=6            # max photo extractions per minute, 0 = unlimited
